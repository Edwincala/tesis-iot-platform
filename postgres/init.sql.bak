WHERE u.username = 'demo'
ON CONFLICT DO NOTHING;

INSERT INTO measurements (device_id, user_id, value, timestamp, quality)
SELECT 
    d.id,
    u.id,
    CASE 
        WHEN d.variable = 'temperatura' THEN 22 + 5 * sin(extract(epoch from generate_series) / 3600) + random() * 2
        WHEN d.variable = 'humedad' THEN 55 + 15 * sin(extract(epoch from generate_series) / 7200 + 1) + random() * 5
        WHEN d.variable = 'presion' THEN 1013 + 5 * sin(extract(epoch from generate_series) / 10800) + random() * 2
        WHEN d.variable = 'luz' THEN 300 + 200 * sin(extract(epoch from generate_series) / 43200 + 2) + random() * 50
        ELSE 0
    END,
    generate_series,
    95 + floor(random() * 5)::int
FROM devices d
JOIN users u ON d.user_id = u.id
CROSS JOIN LATERAL generate_series(
    NOW() - INTERVAL '24 hours',
    NOW(),
    INTERVAL '5 minutes'
)
WHERE d.device_type = 'sensor' AND d.is_active = true
ON CONFLICT DO NOTHING;

INSERT INTO notifications (user_id, type, title, message, created_at)
SELECT 
    u.id,
    'info',
    'Bienvenido a la Plataforma IoT',
    'Tu plataforma de monitoreo en tiempo real está lista para usar.',
    NOW() - INTERVAL '1 hour'
FROM users u
WHERE u.username IN ('demo', 'juan.perez', 'maria.garcia')
ON CONFLICT DO NOTHING;

INSERT INTO audit_log (user_id, action, details, timestamp)
SELECT 
    u.id,
    'login',
    jsonb_build_object(
        'method', 'password',
        'success', true,
        'ip', '192.168.1.100'
    ),
    NOW() - INTERVAL '1 hour' * generate_series(1, 10)
FROM users u
WHERE u.username IN ('admin', 'demo')
ON CONFLICT DO NOTHING;

CREATE OR REPLACE PROCEDURE archive_old_measurements(
    p_days_to_keep INTEGER DEFAULT 30
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_cutoff_date TIMESTAMPTZ;
BEGIN
    v_cutoff_date := NOW() - (p_days_to_keep || ' days')::INTERVAL;
    
    CREATE TABLE IF NOT EXISTS measurements_archive (
        LIKE measurements INCLUDING ALL
    );
    
    INSERT INTO measurements_archive
    SELECT * FROM measurements 
    WHERE timestamp < v_cutoff_date;
    
    DELETE FROM measurements 
    WHERE timestamp < v_cutoff_date;
    
    RAISE NOTICE 'Archivadas mediciones anteriores a %', v_cutoff_date;
END;
$$;

CREATE OR REPLACE PROCEDURE clean_audit_logs(
    p_days_to_keep INTEGER DEFAULT 90
)
LANGUAGE plpgsql
AS $$
BEGIN
    DELETE FROM audit_log 
    WHERE timestamp < NOW() - (p_days_to_keep || ' days')::INTERVAL;
    
    RAISE NOTICE 'Logs de auditoría limpiados (mantenidos % días)', p_days_to_keep;
END;
$$;

CREATE OR REPLACE FUNCTION generate_daily_report(
    p_date DATE DEFAULT CURRENT_DATE
)
RETURNS TABLE(
    metric_name TEXT,
    metric_value TEXT
) AS $$
BEGIN
    RETURN QUERY
    SELECT 'Total de Mediciones'::TEXT, COUNT(*)::TEXT
    FROM measurements
    WHERE DATE(timestamp) = p_date
    
    UNION ALL
    
    SELECT 'Dispositivos Activos'::TEXT, COUNT(DISTINCT device_id)::TEXT
    FROM measurements
    WHERE DATE(timestamp) = p_date
    
    UNION ALL
    
    SELECT 'Alertas Generadas'::TEXT, COUNT(*)::TEXT
    FROM alerts
    WHERE DATE(triggered_at) = p_date
    
    UNION ALL
    
    SELECT 'Usuarios Activos'::TEXT, COUNT(DISTINCT user_id)::TEXT
    FROM audit_log
    WHERE DATE(timestamp) = p_date
        AND action = 'login';
END;
$$ LANGUAGE plpgsql;

DO $$
DECLARE
    v_table_name TEXT;
    v_start_date DATE;
    v_end_date DATE;
BEGIN
    v_start_date := DATE_TRUNC('month', NOW())::DATE;
    v_end_date := (DATE_TRUNC('month', NOW()) + INTERVAL '1 month')::DATE;
    v_table_name := 'measurements_' || TO_CHAR(v_start_date, 'YYYY_MM');
    
    EXECUTE format('
        CREATE TABLE IF NOT EXISTS %I PARTITION OF measurements
        FOR VALUES FROM (%L) TO (%L)
    ', v_table_name, v_start_date, v_end_date);
    
    RAISE NOTICE 'Partition % creada para % - %', v_table_name, v_start_date, v_end_date;
END;
$$;

CREATE OR REPLACE FUNCTION reset_device_statistics(
    p_device_id INTEGER
)
RETURNS VOID AS $$
BEGIN
    UPDATE devices 
    SET 
        reading_count = 0,
        min_value = NULL,
        max_value = NULL,
        avg_value = NULL,
        last_reading = NULL,
        last_value = NULL
    WHERE id = p_device_id;
    
    RAISE NOTICE 'Estadísticas reseteadas para dispositivo %', p_device_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE VIEW v_disk_usage AS
SELECT 
    schemaname,
    tablename,
    pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename)) AS total_size,
    pg_size_pretty(pg_relation_size(schemaname||'.'||tablename)) AS table_size,
    pg_size_pretty(pg_total_relation_size(schemaname||'.'||tablename) - 
                   pg_relation_size(schemaname||'.'||tablename)) AS index_size,
    pg_total_relation_size(schemaname||'.'||tablename) AS bytes
FROM pg_tables
WHERE schemaname = 'public'
ORDER BY bytes DESC;