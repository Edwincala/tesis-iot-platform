# CONFIGURACIÓN GENERAL
NODE_ENV=development
LOG_LEVEL=info

# POSTGRESQL
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_pass
POSTGRES_DB=iot_platform
POSTGRES_PORT=5432

# MOSQUITTO MQTT
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TLS_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# REDIS
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# BACKEND
BACKEND_PORT=3001
JWT_SECRET=mi-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# FRONTEND
FRONTEND_PORT=3000
REACT_APP_TITLE=Plataforma IoT Tesis

# ML SERVICE
ML_PORT=8000
MODEL_UPDATE_INTERVAL=300

# SIMULADOR
SIMULATOR_INTERVAL=3
SIMULATOR_DEVICES=temperatura,humedad,presion,luz